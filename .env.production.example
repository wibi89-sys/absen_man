# ==============================================================================
# MADRASAH ONE - Konfigurasi Lingkungan Produksi (.env)
# ==============================================================================

APP_NAME="MADRASAH ONE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madrasah-anda.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Konfigurasi Database (MySQL / MariaDB di Hosting)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_anda
DB_USERNAME=user_database_anda
DB_PASSWORD=password_database_anda

# ------------------------------------------------------------------------------
# Session, Cache, & Queue
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# Pengaturan Email Notifikasi (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=madrasah.notifikasi@gmail.com
MAIL_PASSWORD=app_password_anda
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@madrasah-anda.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Fitur Mesin Absensi Biometrik LAN (ADMS Port)
# ------------------------------------------------------------------------------
ATTENDANCE_MACHINE_PORT=4370
ATTENDANCE_GEO_DEFAULT_RADIUS=100
